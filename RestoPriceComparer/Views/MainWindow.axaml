<Window xmlns="https://github.com/avaloniaui"
        xmlns:Models="using:RestoPriceComparer.Models"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:RestoPriceComparer.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="RestoPriceComparer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="RestoPriceComparer">

    <StackPanel Margin="30" Spacing="15">

        <TextBlock
            Text="Mon comparateur de prix"
            FontSize="28"
            FontWeight="Bold"
            HorizontalAlignment="Center"/>

        <TextBlock
            Text="{Binding Greeting}"
            FontSize="18"
            HorizontalAlignment="Center"/>

        <StackPanel Orientation="Horizontal"
                    Spacing="10" 
                    HorizontalAlignment="Center">
            
            <TextBox
                PlaceholderText="Rechercher un produit..."
                Width="300"
                HorizontalAlignment="Center"/>

            <Button
                Content="Rechercher"
                HorizontalAlignment="Left"/>
        </StackPanel>
        
        <ListBox ItemsSource="{Binding Suppliers}" >
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="Models:Supplier">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" 
                                    Orientation="Horizontal" 
                                    Spacing="10">
                            <TextBlock Text="{Binding Name}" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding WebsiteUrl}" 
                                       Foreground="Gray"/>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Content="Supprimer"
                                Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).DeleteSupplierCommand}"
                                CommandParameter="{Binding}"
                                Background="DarkRed"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" 
                    Spacing="10" 
                    HorizontalAlignment="Center">
            <TextBox
                PlaceholderText="Nom du fournisseur"
                Width="200"
                Text="{Binding NewSupplierName, 
                UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox
                PlaceholderText="URL du site web"
                Width="400"
                Text="{Binding NewSupplierWebsiteUrl, 
                UpdateSourceTrigger=PropertyChanged}"/>
            <Button
                Content="Ajouter un fournisseur"
                Command="{Binding AddSupplierCommand}"/>
        </StackPanel>

    </StackPanel>

</Window>
