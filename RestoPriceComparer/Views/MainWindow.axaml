<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:RestoPriceComparer.ViewModels"
        xmlns:models="using:RestoPriceComparer.Models"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="RestoPriceComparer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="RestoPriceComparer">

    <StackPanel Margin="30" Spacing="15">

        <!-- En-tête -->
        <TextBlock Text="Mon comparateur de prix"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        <TextBlock Text="{Binding Greeting}"
                   FontSize="18"
                   HorizontalAlignment="Center"/>

        <!-- Recherche (pas encore branchée) -->
        <StackPanel Orientation="Horizontal"
                    Spacing="10"
                    HorizontalAlignment="Center">
            <TextBox PlaceholderText="Rechercher un produit..."
                     Width="300"/>
            <Button Content="Rechercher"/>
        </StackPanel>

        <!-- Liste des fournisseurs -->
        <ListBox ItemsSource="{Binding Suppliers}">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Supplier">
                    <Grid ColumnDefinitions="*,Auto">

                        <!-- Colonne gauche : informations -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="10">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding WebsiteUrl}"
                                       Foreground="Gray"/>
                        </StackPanel>

                        <!-- Colonne droite : actions de la ligne -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="5">
                            <Button Content="Modifier"
                                    Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).StartEditCommand}"
                                    CommandParameter="{Binding}"
                                    Background="DarkOrange"/>
                            <Button Content="Supprimer"
                                    Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).DeleteSupplierCommand}"
                                    CommandParameter="{Binding}"
                                    Background="DarkRed"/>
                        </StackPanel>

                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Formulaire : ajout et modification -->
        <StackPanel Orientation="Horizontal"
                    Spacing="10"
                    HorizontalAlignment="Center">
            <TextBox PlaceholderText="Nom du fournisseur"
                     Width="200"
                     Text="{Binding NewSupplierName, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox PlaceholderText="URL du site web"
                     Width="400"
                     Text="{Binding NewSupplierWebsiteUrl, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Enregistrer"
                    Command="{Binding SaveSupplierCommand}"/>
            <Button Content="Annuler"
                    Command="{Binding CancelEditCommand}"/>
        </StackPanel>

    </StackPanel>

</Window>
